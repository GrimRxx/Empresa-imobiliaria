# ------------------------------------------------------------------
# Para onde vão as indicações enviadas pelo formulário.
# Configure PELO MENOS UMA das opções abaixo (e-mail e/ou planilha).
# Copie este arquivo para ".env.local" (ou cadastre as variáveis no
# painel da hospedagem, ex.: Vercel > Settings > Environment Variables).
# ------------------------------------------------------------------

# --- Opção 1: receber cada indicação por e-mail (SMTP) ---
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 e uma
# "senha de app" (https://myaccount.google.com/apppasswords) em SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente exibido no e-mail (padrão: SMTP_USER)
SMTP_FROM=
# Quem recebe as indicações (pode ser mais de um, separados por vírgula)
INDICACAO_EMAIL_DESTINO=contato@prosperarimoveis.com.br

# --- Opção 2: salvar cada indicação numa planilha / sistema ---
# URL que recebe um POST em JSON com os dados da indicação.
# Para Google Sheets, veja docs/google-sheets-apps-script.js
INDICACAO_WEBHOOK_URL=
